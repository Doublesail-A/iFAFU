<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
<ImageView android:id="@+id/widget_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:tint="#FFFBFE" android:src="@drawable/widget_surface" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="18dp" android:gravity="center_vertical" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<FrameLayout android:layout_width="wrap_content" android:layout_height="26dp">
<ImageView android:id="@+id/widget_badge_background" android:layout_width="match_parent" android:layout_height="match_parent" android:tint="#EADDFF" android:src="@drawable/widget_badge" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<TextView android:id="@+id/widget_kind" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingLeft="10dp" android:paddingRight="10dp" android:gravity="center" android:text="下一门课程" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"/>
</FrameLayout>
<TextView android:importantForAccessibility="no" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<ImageView android:id="@+id/widget_icon" android:layout_width="24dp" android:layout_height="24dp" android:tint="#6750A4" android:src="@drawable/ic_m3_calendar_month" android:importantForAccessibility="no"/>
</LinearLayout>
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#FF1D1B20" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end"  android:layout_marginTop="12dp" android:text="下一项安排"/>
<TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FF1D1B20" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="10dp" android:text="时间"/>
<TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#FF1D1B20" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="8dp" android:text="地点"/>
</LinearLayout>
</FrameLayout>
