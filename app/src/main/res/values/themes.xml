<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorPrimary">?attr/colorPrimary</item>
        <item name="android:colorPrimaryDark">?attr/colorSurface</item>
        <item name="android:textColorHighlight">@color/light_gray</item>
        <item name="editTextColor">?attr/colorOnSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="actionBarSize">56dp</item>
        <item name="overlapAnchor">false</item>
        <item name="md_color_button_text">@color/black</item>

        <item name="autoCompleteTextViewStyle">@style/AutoCompleteTextView</item>
        <item name="buttonStyle">@style/Button</item>
        <item name="imageButtonStyle">@style/ImageButton</item>
        <item name="textInputStyle">@style/Information.Widget.Upload.TextInputLayout</item>
        <item name="toolbarStyle">@style/Toolbar</item>
        <item name="wToolbarStyle">@style/woToolbarStyle</item>
    </style>

    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_fafu</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>


    <style name="AppTheme.Electricity" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#33b5e5</item>
        <item name="colorPrimaryDark">#33b5e5</item>
        <item name="colorAccent">#75e7ff</item>
    </style>

    <style name="AppTheme.Login" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorAccent">#9da8d6</item>
        <item name="android:colorPrimary">#cfd9ff</item>
        <item name="android:colorPrimaryDark">#6d79a5</item>
        <item name="colorPrimary">@color/colorPrimary2</item>
        <item name="colorPrimaryVariant">@color/colorDart</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox
        </item>
    </style>

</resources>
